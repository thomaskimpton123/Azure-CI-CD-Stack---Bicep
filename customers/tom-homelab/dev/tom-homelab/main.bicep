// ============================================================================
// TYPES AND OUTPUTS
// ============================================================================

type globalConfigType = {
  @description('Name of this infrastructure package and its GitHub folder.')
  infrastructureName: string
  @description('Customer or deal name.')
  customer: string
  @description('Workload or project name.')
  workload: string
  @description('Deployment environment.')
  environment: 'dev' | 'test' | 'prod'
  @description('Primary Azure region.')
  location: string
  @description('Target subscription purpose or classification.')
  subscriptionPurpose: string?
  @description('Cost centre or accountable owner.')
  costCentreOrOwner: string?
  @description('Additional resource tags.')
  tags: object
  @description('Legacy fallback resource group used only when the package has no explicit Resource Groups tile.')
  resourceGroupName: string?
}

output naming object = {
  environmentPrefix: environmentPrefix
  regionalPrefix: regionalPrefix
  resourceGroupName: primaryResourceGroupName
}
output tags object = mergedTags
output selectedServiceConfigurations object = {
  automation: automationConfigurations
  azureFirewall: azureFirewallConfigurations
  azurePolicy: azurePolicyConfigurations
  backup: backupConfigurations
  bastion: bastionConfigurations
  costManagement: costManagementConfigurations
  ddos: ddosConfigurations

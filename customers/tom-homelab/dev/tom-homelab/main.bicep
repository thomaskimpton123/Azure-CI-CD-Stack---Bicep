// ============================================================================
// NAMED INFRASTRUCTURE PACKAGE — tom-homelab
// Validated entry point generated by Skyforge.
// Supported selections emit deployable resources; remaining services retain typed review configuration.
// Deployable: automation, azure-firewall, azure-policy, backup, bastion, cost-management, ddos, defender-cloud, dns-private-resolver, expressroute, log-analytics, managed-identities, network-watcher, private-dns, resource-groups, route-tables, sentinel, vnet, vpn-gateway
// Review-only (creates no Azure resources): none
// See deployment-coverage.json for the per-instance breakdown.
// ============================================================================

targetScope = 'managementGroup'

// ============================================================================
// PARAMETERS — customer-editable configuration
// ============================================================================

@description('Customer, deployment and naming context shared by every selected service.')
param globalConfig globalConfigType

@description('Typed configuration arrays for the selected Azure services.')
param serviceConfigurations object = {}

@description('Subscription IDs by alias. Every subscription must sit below the management group this deploys to.')
param subscriptionIds object

@secure()
@description('Site-to-site pre-shared keys by site name. Supply at deployment time (never in this repository); sites without a key get no connection yet.')
param vpnSharedKeys object = {}

// ============================================================================
// VARIABLES — names and shared values derived in one place
// ============================================================================

var environmentPrefix = '${globalConfig.infrastructureName}-${globalConfig.environment}'
var regionalPrefix = '${environmentPrefix}-${globalConfig.location}'
var mergedTags = union({
  infrastructure: globalConfig.infrastructureName
  environment: globalConfig.environment
  workload: globalConfig.workload
  managedBy: 'bicep'
  customer: globalConfig.customer
}, globalConfig.tags)

var automationConfigurations = serviceConfigurations.?automation ?? []
var azureFirewallConfigurations = serviceConfigurations.?azureFirewall ?? []
var azurePolicyConfigurations = serviceConfigurations.?azurePolicy ?? []
var backupConfigurations = serviceConfigurations.?backup ?? []
var bastionConfigurations = serviceConfigurations.?bastion ?? []
var costManagementConfigurations = serviceConfigurations.?costManagement ?? []
var ddosConfigurations = serviceConfigurations.?ddos ?? []
var defenderCloudConfigurations = serviceConfigurations.?defenderCloud ?? []
var dnsPrivateResolverConfigurations = serviceConfigurations.?dnsPrivateResolver ?? []
var expressrouteConfigurations = serviceConfigurations.?expressroute ?? []
var logAnalyticsConfigurations = serviceConfigurations.?logAnalytics ?? []
var managedIdentitiesConfigurations = serviceConfigurations.?managedIdentities ?? []
var networkWatcherConfigurations = serviceConfigurations.?networkWatcher ?? []
var privateDnsConfigurations = serviceConfigurations.?privateDns ?? []
var resourceGroupsConfigurations = serviceConfigurations.?resourceGroups ?? []
var routeTablesConfigurations = serviceConfigurations.?routeTables ?? []
var sentinelConfigurations = serviceConfigurations.?sentinel ?? []
var vnetConfigurations = serviceConfigurations.?vnet ?? []
var vpnGatewayConfigurations = serviceConfigurations.?vpnGateway ?? []

var primaryResourceGroupName = resourceGroupsConfigurations[0].resourceName

module resourceGroups 'modules/resource-groups.bicep' = [for alias in ['app-dev', 'management', 'connectivity', 'identity']: {
  name: take('resource-groups-${alias}', 64)
  scope: subscription(subscriptionIds[alias])
  params: {
    instances: filter(resourceGroupsConfigurations, group => group.subscriptionId == subscriptionIds[alias])
    defaultLocation: globalConfig.location
    tags: mergedTags
  }
}]

@description('Region of NetworkWatcherRG. If the group already exists in another region, set its region here.')
param networkWatcherResourceGroupLocation string = globalConfig.location

module networkWatcherResourceGroups 'modules/resource-groups.bicep' = [for (instance, index) in networkWatcherConfigurations: {
  name: take('network-watcher-rg-${index}-${uniqueString(instance.subscriptionId)}', 64)
  scope: subscription(instance.subscriptionId)
  params: {
    instances: [{ resourceName: 'NetworkWatcherRG' }]
    defaultLocation: networkWatcherResourceGroupLocation
    tags: mergedTags
  }
}]

// ============================================================================
// MODULES — one selected infrastructure concern per file
// ============================================================================

module resourceGroupLocks 'modules/resource-group-locks.bicep' = [for instance in resourceGroupsConfigurations: if ((instance.?lockLevel ?? 'None') != 'None') {
  scope: resourceGroup(instance.subscriptionId, instance.resourceName)
  params: {
    level: instance.?lockLevel ?? 'CanNotDelete'
    notes: instance.?lockNotes ?? 'Managed by the Azure infrastructure pack'
  }
  dependsOn: [resourceGroups]
}]

// Coverage: deployable — modules/automation.bicep declares Azure resources.
module automation 'modules/automation.bicep' = [for instance in automationConfigurations: {
  scope: resourceGroup(instance.subscriptionId, instance.?resourceGroupRef ?? primaryResourceGroupName)
  params: {
    instances: [instance]
    location: globalConfig.location
    tags: mergedTags
  }
  dependsOn: [resourceGroups, managedIdentities, logAnalytics]
}]


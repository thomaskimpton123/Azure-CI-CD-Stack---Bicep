// ============================================================================
// MANAGEMENT GROUPS — tom-homelab
// Tenant-scope deployment generated by Skyforge. Deploy it before main.bicep:
//   az deployment tenant create --location australiaeast --template-file tenant.bicep --parameters tenant.bicepparam
// It needs rights at the tenant root ('/'), such as Owner or Management Group Contributor there,
// and Owner on each subscription it moves.
// ============================================================================

targetScope = 'tenant'

@description('Management groups to create. Level 1 sits under an existing management group, or the Tenant Root Group when it has no parent; each later level sits under a group created at the level before.')
param managementGroups managementGroupType[]

@description('Subscriptions to place under a management group.')
param subscriptionPlacements subscriptionPlacementType[] = []

type managementGroupType = {
  @description('Management group ID.')
  name: string
  displayName: string
  @description('Parent management group ID. Omitted for the Tenant Root Group.')
  parent: string?
  @description('Depth below the top groups this package creates.')
  @minValue(1)
  @maxValue(6)
  level: int
}

type subscriptionPlacementType = {
  subscriptionId: string
  @description('Management group ID the subscription moves under.')
  managementGroup: string
}

resource level1 'Microsoft.Management/managementGroups@2023-04-01' = [for group in filter(managementGroups, group => group.level == 1): {
  name: group.name
  properties: union({ displayName: group.displayName }, empty(group.?parent ?? '') ? {} : { details: { parent: { id: tenantResourceId('Microsoft.Management/managementGroups', group.parent!) } } })
}]

resource level2 'Microsoft.Management/managementGroups@2023-04-01' = [for group in filter(managementGroups, group => group.level == 2): {
  name: group.name
  properties: union({ displayName: group.displayName }, empty(group.?parent ?? '') ? {} : { details: { parent: { id: tenantResourceId('Microsoft.Management/managementGroups', group.parent!) } } })
  dependsOn: [level1]
}]

resource level3 'Microsoft.Management/managementGroups@2023-04-01' = [for group in filter(managementGroups, group => group.level == 3): {
  name: group.name
  properties: union({ displayName: group.displayName }, empty(group.?parent ?? '') ? {} : { details: { parent: { id: tenantResourceId('Microsoft.Management/managementGroups', group.parent!) } } })
  dependsOn: [level2]
}]

resource placements 'Microsoft.Management/managementGroups/subscriptions@2023-04-01' = [for placement in subscriptionPlacements: {
  name: '${placement.managementGroup}/${placement.subscriptionId}'
  dependsOn: [level1, level2, level3]
}]
